#!/usr/bin/env bash
# The repo's checks. Exit 0 only when the branch is fit to review.
#
# The gate runs this script from the main checkout with the job's worktree as
# the working directory. Keep it fast, deterministic and non-interactive: no
# watch modes, no prompts, nothing that rewrites files. A fresh worktree has no
# installed dependencies or virtualenvs, so install them here when missing.
set -euo pipefail

echo "factory/checks.sh is still the template: put this repo's tests, lint and build here." >&2
exit 1
